{
  "name": "rhythm-score-studio",
  "productName": "RhythmScore",
  "version": "0.1.0",
  "description": "RhythmScore - 将 PDF/JPG/PNG 鼓谱转换为可对轨、可生成动态跟随视频的桌面工作台",
  "main": "out/main/index.js",
  "author": "liuji",
  "license": "MIT",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "lucide-react": "^0.454.0",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.0.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
